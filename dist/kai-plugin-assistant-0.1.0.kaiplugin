{"manifest":{"schema":1,"apiVersion":2,"id":"kai.assistant","name":"KAI Assistant","version":"0.1.0","description":"Private conversations with installed local models, with your existing KAI chat history preserved in place.","entry":"index.html","permissions":["models.read","inference.local","storage.read","storage.write","assistant.read","assistant.write"]},"files":{"app.js":"\"use strict\";\n(() => {\n  const $ = id => document.getElementById(id), call = (method, input) => window.kai.call(method, input), logic = window.AssistantLogic;\n  const state = { chats: [], current: null, messages: [], busy: false, unsaved: false, models: [], lastError: false };\n  const welcome = $(\"messages\").firstElementChild;\n  function notice(message, error = false) { $(\"notice\").textContent = message || \"\"; $(\"notice\").hidden = !message; $(\"notice\").classList.toggle(\"error\", error); }\n  function controls() {\n    for (const id of [\"new-chat\", \"refresh-models\", \"model\", \"tokens\", \"prompt\"]) $(id).disabled = state.busy;\n    for (const id of [\"rename\", \"pin\", \"delete\"]) $(id).disabled = state.busy || !state.current || state.unsaved;\n    $(\"send\").disabled = state.busy || state.unsaved || !$(\"model\").value;\n    $(\"retry\").hidden = !state.lastError || state.unsaved; $(\"retry\").disabled = state.busy || !$(\"model\").value;\n    $(\"save-again\").hidden = !state.unsaved; $(\"save-again\").disabled = state.busy; $(\"save-copy\").hidden = !state.unsaved || !state.current; $(\"save-copy\").disabled = state.busy;\n    for (const button of $(\"history\").querySelectorAll(\"button\")) button.disabled = state.busy || state.unsaved;\n    $(\"new-chat\").disabled = state.busy || state.unsaved;\n  }\n  function renderHistory() {\n    $(\"history\").replaceChildren();\n    for (const chat of logic.filterChats(state.chats, $(\"search\").value)) {\n      const button = document.createElement(\"button\"); button.className = \"history-item\"; button.classList.toggle(\"selected\", chat.id === state.current?.id);\n      const title = document.createElement(\"span\"); title.textContent = (chat.pinned ? \"★ \" : \"\") + chat.title;\n      const details = document.createElement(\"small\"); const date = chat.updatedAt ? new Date(chat.updatedAt) : null;\n      details.textContent = `${chat.messages} messages${date && !Number.isNaN(date.getTime()) ? \" · \" + date.toLocaleDateString(undefined, { month: \"short\", day: \"numeric\" }) : \"\"}`;\n      button.append(title, details); button.addEventListener(\"click\", () => guarded(() => openChat(chat.id))); $(\"history\").append(button);\n    }\n    if (!$(\"history\").children.length) { const text = document.createElement(\"p\"); text.className = \"empty-history\"; text.textContent = state.chats.length ? \"No matching conversations.\" : \"Your conversations will appear here.\"; $(\"history\").append(text); }\n    controls();\n  }\n  function renderMessages() {\n    $(\"messages\").replaceChildren(); if (!state.messages.length) $(\"messages\").append(welcome);\n    for (const message of state.messages) {\n      const article = document.createElement(\"article\"); article.className = `message ${message.role === \"user\" ? \"user\" : \"assistant\"}`;\n      const label = document.createElement(\"div\"); label.className = \"message-label\"; label.textContent = message.role === \"user\" ? \"YOU\" : message.role === \"assistant\" ? \"KAI ASSISTANT\" : \"SAVED CONTEXT\";\n      const content = document.createElement(\"div\"); content.className = \"message-content\"; content.textContent = message.content;\n      article.append(label, content);\n      if (message.attachments) { const note = document.createElement(\"small\"); note.className = \"attachment-note\"; note.textContent = `${message.attachments} saved attachment(s) preserved. This text conversation does not send images to the model.`; article.append(note); }\n      $(\"messages\").append(article);\n    }\n    $(\"chat-title\").textContent = state.current?.title || \"A little space to think.\";\n    $(\"chat-subtitle\").textContent = state.current ? \"Saved conversation · Shared with your existing KAI profile\" : \"Write, explore, and work through ideas with a local model.\";\n    $(\"pin\").textContent = state.current?.pinned ? \"★\" : \"☆\"; $(\"pin\").setAttribute(\"aria-label\", state.current?.pinned ? \"Remove from favorites\" : \"Add to favorites\");\n    $(\"messages\").scrollTop = $(\"messages\").scrollHeight; controls();\n  }\n  async function listChats() { const result = await call(\"assistant.list\", {}); state.chats = result.chats; renderHistory(); if (result.warnings?.length) notice(result.warnings.join(\" \"), true); }\n  async function openChat(id) { if (state.unsaved) return; state.current = await call(\"assistant.get\", { id }); state.messages = state.current.messages; state.lastError = state.messages.at(-1)?.role === \"user\"; notice(\"\"); $(\"rename-form\").hidden = true; renderMessages(); renderHistory(); }\n  async function loadModels() {\n    const previous = $(\"model\").value; state.models = logic.readyModels(await call(\"models.list\", {})); $(\"model\").replaceChildren();\n    if (!state.models.length) { const option = document.createElement(\"option\"); option.value = \"\"; option.textContent = \"No local model installed\"; $(\"model\").append(option); }\n    for (const model of state.models) { const option = document.createElement(\"option\"); option.value = model.alias; option.textContent = model.label; $(\"model\").append(option); }\n    if (state.models.some(m => m.alias === previous)) $(\"model\").value = previous;\n    $(\"model-status\").textContent = state.models.length ? \"On-device inference\" : \"Install a model in Core → Models, then refresh.\"; controls();\n  }\n  async function save() {\n    try { const saved = await call(\"assistant.save\", { ...(state.current ? { id: state.current.id, revision: state.current.revision } : {}), messages: state.messages.map(({ role, content }) => ({ role, content })) });\n      state.current = { ...(state.current || { title: state.messages.find(m => m.role === \"user\")?.content.slice(0, 80) || \"Untitled chat\", pinned: false, system: \"\" }), ...saved, messages: state.messages }; state.unsaved = false; await listChats(); renderMessages();\n    } catch (error) { state.unsaved = true; controls(); throw error; }\n  }\n  async function reply() {\n    const context = logic.buildPrompt(state.messages, state.current?.system || \"\");\n    if (context.omitted || context.systemTrimmed) notice(`Using the most recent conversation context${context.omitted ? `; ${context.omitted} earlier message(s) remain saved` : \"\"}${context.systemTrimmed ? \"; the saved instructions were shortened for this request\" : \"\"}.`);\n    const started = performance.now(); $(\"working\").textContent = \"Thinking locally…\";\n    const result = await call(\"inference.local\", { model: $(\"model\").value, prompt: context.prompt, maxTokens: Number($(\"tokens\").value) });\n    if (typeof result?.text !== \"string\" || !result.text.trim()) throw Error(\"The local model returned an empty reply. You can retry.\");\n    state.messages.push({ role: \"assistant\", content: result.text }); state.lastError = false; renderMessages();\n    $(\"working\").textContent = `Replied in ${((performance.now() - started) / 1000).toFixed(1)}s`; await save();\n  }\n  async function guarded(action) { if (state.busy) return; state.busy = true; controls(); try { await action(); } catch (error) { notice(error.message || String(error), true); } finally { state.busy = false; controls(); } }\n  async function runReply(addMessage) {\n    if (state.busy || state.unsaved || !$(\"model\").value) return; const content = $(\"prompt\").value.trim(); if (addMessage && !content) return;\n    state.busy = true; state.lastError = false; notice(\"\"); controls();\n    try { if (addMessage) { state.messages.push({ role: \"user\", content }); $(\"prompt\").value = \"\"; renderMessages(); await save(); } await reply(); }\n    catch (error) { state.lastError = state.messages.at(-1)?.role === \"user\"; $(\"working\").textContent = \"\"; notice((state.unsaved ? \"Conversation not saved. Your text is still visible here. \" : \"\") + (error.message || String(error)), true); }\n    finally { state.busy = false; controls(); $(\"prompt\").focus(); }\n  }\n  $(\"composer\").addEventListener(\"submit\", event => { event.preventDefault(); void runReply(true); });\n  $(\"prompt\").addEventListener(\"keydown\", event => { if (event.key === \"Enter\" && (event.ctrlKey || event.metaKey)) { event.preventDefault(); void runReply(true); } });\n  $(\"retry\").addEventListener(\"click\", () => void runReply(false));\n  $(\"save-again\").addEventListener(\"click\", () => guarded(async () => { state.busy = true; controls(); try { await save(); notice(\"Conversation saved.\"); } finally { state.busy = false; } }));\n  $(\"save-copy\").addEventListener(\"click\", () => guarded(async () => {\n    const messages = state.messages.map(({ role, content }) => ({ role, content }));\n    const saved = await call(\"assistant.save\", { messages });\n    state.current = { ...saved, title: messages.find(m => m.role === \"user\")?.content.slice(0, 80) || \"Untitled chat\", pinned: false, system: \"\", messages };\n    state.messages = messages; state.unsaved = false; await listChats(); renderMessages(); notice(\"Saved as a new text conversation. The original conversation and its attachments remain unchanged.\");\n  }));\n  function resetChat() { state.current = null; state.messages = []; state.lastError = false; $(\"prompt\").value = \"\"; $(\"working\").textContent = \"\"; $(\"rename-form\").hidden = true; notice(\"\"); renderMessages(); renderHistory(); $(\"prompt\").focus(); }\n  $(\"new-chat\").addEventListener(\"click\", () => { if (!state.busy && !state.unsaved) resetChat(); });\n  $(\"search\").addEventListener(\"input\", renderHistory); $(\"refresh-models\").addEventListener(\"click\", () => guarded(loadModels));\n  $(\"rename\").addEventListener(\"click\", () => { $(\"rename-form\").hidden = false; $(\"rename-title\").value = state.current.title; $(\"rename-title\").focus(); });\n  $(\"cancel-rename\").addEventListener(\"click\", () => { $(\"rename-form\").hidden = true; });\n  $(\"rename-form\").addEventListener(\"submit\", event => { event.preventDefault(); void guarded(async () => { const result = await call(\"assistant.rename\", { id: state.current.id, revision: state.current.revision, title: $(\"rename-title\").value.trim() }); Object.assign(state.current, result, { title: $(\"rename-title\").value.trim() }); $(\"rename-form\").hidden = true; await listChats(); renderMessages(); }); });\n  $(\"pin\").addEventListener(\"click\", () => guarded(async () => { const pinned = !state.current.pinned; const result = await call(\"assistant.pin\", { id: state.current.id, revision: state.current.revision, pinned }); Object.assign(state.current, result, { pinned }); await listChats(); renderMessages(); }));\n  $(\"delete\").addEventListener(\"click\", () => guarded(async () => { const result = await call(\"assistant.delete\", { id: state.current.id, revision: state.current.revision }); if (result.deleted) { resetChat(); await listChats(); } }));\n  for (const button of document.querySelectorAll(\"[data-prompt]\")) button.addEventListener(\"click\", () => { $(\"prompt\").value = button.dataset.prompt; $(\"prompt\").focus(); });\n  async function preferences() { await call(\"storage.set\", { key: \"preferences\", value: { model: $(\"model\").value, maxTokens: Number($(\"tokens\").value) } }); }\n  for (const id of [\"model\", \"tokens\"]) $(id).addEventListener(\"change\", () => { controls(); void guarded(preferences); });\n  void guarded(async () => {\n    if (!window.kai?.call || window.kai.apiVersion < 2) throw Error(\"Open this plugin in KAI Core 0.2.0 or later.\");\n    await Promise.all([listChats(), loadModels()]); const saved = await call(\"storage.get\", { key: \"preferences\" });\n    if (saved && state.models.some(m => m.alias === saved.model)) $(\"model\").value = saved.model;\n    if ([512, 1024, 2048, 4096].includes(saved?.maxTokens)) $(\"tokens\").value = String(saved.maxTokens); controls();\n  });\n})();\n","index.html":"<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>KAI Assistant</title><link rel=\"stylesheet\" href=\"style.css\"></head>\n<body><div class=\"app\"><aside class=\"sidebar\"><div class=\"brand\"><span class=\"brand-icon\">k</span><div>KAI <strong>Assistant</strong><small>YOUR PRIVATE WORKSPACE</small></div></div><button class=\"primary\" id=\"new-chat\">+ New conversation</button><label class=\"search-label\" for=\"search\">Conversations</label><input id=\"search\" type=\"search\" placeholder=\"Find a conversation\" autocomplete=\"off\"><div id=\"history\" class=\"history\" aria-label=\"Saved conversations\"></div><div class=\"sidebar-note\"><span class=\"status-dot\"></span> Saved on this device<p>Your existing KAI conversations stay in the same place.</p></div></aside>\n<main><header><div><div class=\"eyebrow\">ASSISTANT <span class=\"local-badge\">LOCAL ONLY</span></div><h1 id=\"chat-title\">A little space to think.</h1><p id=\"chat-subtitle\">Write, explore, and work through ideas with a local model.</p></div><div class=\"chat-actions\"><button class=\"icon-button\" id=\"rename\" title=\"Rename conversation\" disabled>Rename</button><button class=\"icon-button\" id=\"pin\" title=\"Favorite conversation\" disabled>☆</button><button class=\"icon-button danger\" id=\"delete\" title=\"Delete conversation\" disabled>Delete</button></div></header>\n<form id=\"rename-form\" class=\"rename-form\" hidden><label for=\"rename-title\">Conversation title</label><input id=\"rename-title\" maxlength=\"80\" required><button class=\"primary\" type=\"submit\">Save title</button><button type=\"button\" id=\"cancel-rename\">Cancel</button></form>\n<div class=\"model-bar\"><label for=\"model\">Local model</label><select id=\"model\" aria-label=\"Local model\"><option value=\"\">Loading installed models…</option></select><button id=\"refresh-models\" class=\"icon-button\" title=\"Refresh models\">↻</button><span id=\"model-status\">Checking availability</span></div>\n<div id=\"notice\" class=\"notice\" role=\"status\" hidden></div>\n<section id=\"messages\" class=\"messages\" aria-label=\"Conversation\"><div class=\"welcome\"><div class=\"welcome-symbol\">✳</div><h2>What’s on your mind?</h2><p>Bring a question, a rough draft, or an idea.<br>Your model runs locally. Your conversation stays here.</p><div class=\"suggestions\"><button data-prompt=\"Help me organize a complex idea into a clear outline.\"><strong>Find the structure</strong><span>Make an idea easier to explain ↗</span></button><button data-prompt=\"Help me think through a decision. Ask me about my options and priorities first.\"><strong>Think it through</strong><span>Explore a decision together ↗</span></button><button data-prompt=\"Help me write a first draft. Ask what I am writing and who it is for.\"><strong>Start with a draft</strong><span>Get past the blank page ↗</span></button></div></div></section>\n<div class=\"composer-wrap\"><form id=\"composer\" class=\"composer\"><label class=\"sr-only\" for=\"prompt\">Your message</label><textarea id=\"prompt\" placeholder=\"Ask something, or start an idea…\" maxlength=\"12000\" rows=\"3\" required></textarea><div class=\"composer-tools\"><label for=\"tokens\">Reply limit <select id=\"tokens\"><option value=\"512\">512 tokens</option><option value=\"1024\" selected>1,024 tokens</option><option value=\"2048\">2,048 tokens</option><option value=\"4096\">4,096 tokens</option></select></label><span id=\"working\" role=\"status\"></span><button type=\"button\" id=\"retry\" hidden>Retry reply</button><button type=\"button\" id=\"save-again\" hidden>Save again</button><button type=\"button\" id=\"save-copy\" hidden>Save text as new chat</button><button class=\"primary send\" id=\"send\" type=\"submit\" disabled>Send message <span>↑</span></button></div></form><p class=\"composer-footnote\">Local AI can make mistakes. Check details that matter. <span>Ctrl / ⌘ + Enter to send</span></p></div>\n</main></div><script src=\"logic.js\"></script><script src=\"app.js\"></script></body></html>\n","logic.js":"(function (root, factory) { const api = factory(); if (typeof module === \"object\" && module.exports) module.exports = api; else root.AssistantLogic = api; })(typeof globalThis !== \"undefined\" ? globalThis : this, function () {\n  \"use strict\";\n  function buildPrompt(messages, system = \"\", limit = 16000) {\n    if (!Array.isArray(messages) || !messages.length) throw Error(\"Add a message first\");\n    const prefix = \"Continue this conversation. Reply to the most recent user message.\\n\" + (system ? \"Instructions: \" + String(system).slice(0, 3000) + \"\\n\" : \"\");\n    const suffix = \"\\nAssistant:\", selected = []; let used = prefix.length + suffix.length;\n    for (let i = messages.length - 1; i >= 0; i--) {\n      const message = messages[i]; if (!message || typeof message.content !== \"string\") throw Error(\"Invalid conversation message\");\n      const text = `${message.role === \"assistant\" ? \"Assistant\" : message.role === \"system\" ? \"Instructions\" : message.role === \"user\" ? \"User\" : \"Context\"}: ${message.content}\\n`;\n      if (used + text.length > limit) { if (!selected.length) throw Error(\"The latest message is too long for local inference\"); break; }\n      selected.unshift(text); used += text.length;\n    }\n    return { prompt: prefix + selected.join(\"\") + suffix, omitted: messages.length - selected.length, systemTrimmed: String(system).length > 3000 };\n  }\n  function readyModels(value) { return Array.isArray(value) ? value.filter(m => m && m.status === \"ready\" && typeof m.alias === \"string\" && m.alias).map(m => ({ alias: m.alias, label: typeof m.label === \"string\" ? m.label : m.alias })) : []; }\n  function filterChats(chats, query) { const search = String(query || \"\").toLocaleLowerCase().trim(); return chats.filter(chat => String(chat.title || \"\").toLocaleLowerCase().includes(search)); }\n  return { buildPrompt, readyModels, filterChats };\n});\n","style.css":":root{color-scheme:dark;--bg:#101219;--panel:#171a24;--line:#2b2e3c;--text:#edf0fa;--muted:#969eb2;--accent:#b4a4ff;--mint:#86d8bc;font-family:Inter,ui-sans-serif,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;font-size:14px}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text)}button,input,select,textarea{font:inherit}button{color:var(--text);background:#222633;border:1px solid var(--line);border-radius:9px;padding:10px 13px;cursor:pointer}button:hover:enabled{background:#303546;border-color:#55526d}button:disabled{opacity:.44;cursor:not-allowed}button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible{outline:2px solid var(--accent);outline-offset:3px}input,select,textarea{color:var(--text);background:#12151e;border:1px solid var(--line);border-radius:8px;padding:10px;min-width:0}.primary{background:var(--accent);border-color:var(--accent);color:#191429;font-weight:650}.primary:hover:enabled{background:#c6baff;border-color:#c6baff}.app{display:grid;grid-template-columns:242px minmax(0,1fr);height:100dvh;min-height:560px}.sidebar{display:flex;flex-direction:column;padding:25px 17px 18px;background:#151822;border-right:1px solid var(--line);min-height:0}.brand{display:flex;align-items:center;gap:10px;margin:0 0 30px 4px;font-size:17px;letter-spacing:.2px}.brand-icon{display:grid;place-items:center;width:35px;height:35px;background:#322b49;color:var(--accent);border:1px solid #52456d;border-radius:10px;font-size:28px;font-weight:700;line-height:1}.brand strong{font-weight:550}.brand small{display:block;margin-top:6px;letter-spacing:1.2px;font-size:8px;color:var(--muted)}.sidebar>.primary{text-align:left;margin-bottom:27px}.search-label{font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:1px;margin-bottom:10px}.sidebar input{width:100%;font-size:12px;margin-bottom:12px}.history{overflow:auto;flex:1}.history-item{width:100%;border:1px solid transparent;background:transparent;text-align:left;padding:12px 10px;margin:3px 0}.history-item span{display:block;text-overflow:ellipsis;overflow:hidden;white-space:nowrap;font-size:13px}.history-item small{display:block;color:var(--muted);font-size:10px;margin-top:6px}.history-item.selected{background:#2b283b;border-color:#48405e}.empty-history{font-size:12px;line-height:1.7;padding:8px;color:var(--muted)}.sidebar-note{font-size:11px;color:#bdc7ce;border-top:1px solid var(--line);padding:16px 6px 0;margin-top:15px}.sidebar-note p{line-height:1.6;color:var(--muted);margin-bottom:0}.status-dot{display:inline-block;width:6px;height:6px;background:var(--mint);border-radius:50%;margin-right:6px}main{display:flex;flex-direction:column;min-width:0;min-height:0}header{padding:26px 28px 19px;display:flex;justify-content:space-between;align-items:center;gap:15px}h1{font-size:23px;line-height:1.3;letter-spacing:-.6px;font-weight:550;margin:12px 0 7px;overflow-wrap:anywhere}header p{font-size:11px;color:var(--muted);margin:0}.eyebrow{font-size:9px;letter-spacing:1.6px;color:var(--muted);display:flex;align-items:center;gap:12px}.local-badge{font-size:8px;letter-spacing:.8px;color:var(--mint);padding:4px 6px;border:1px solid #294c43;background:#192c28;border-radius:4px}.chat-actions{display:flex;gap:6px;flex-shrink:0}.icon-button{background:transparent;font-size:11px;padding:7px 9px}.danger{color:#eea9ac}.model-bar{display:flex;gap:11px;align-items:center;border-block:1px solid var(--line);padding:11px 28px;font-size:11px;background:#141720}.model-bar label{color:var(--muted);white-space:nowrap}.model-bar select{max-width:270px;flex:1;font-size:11px;padding:7px}.model-bar>span{margin-left:auto;color:var(--muted);font-size:10px}.messages{overflow:auto;flex:1;padding:24px 28px;scroll-behavior:smooth}.welcome{display:flex;align-items:center;flex-direction:column;text-align:center;max-width:690px;margin:32px auto}.welcome-symbol{height:54px;width:54px;display:grid;place-items:center;border:1px solid #443b60;background:radial-gradient(circle at 25% 20%,#3d3455,#211d30);border-radius:17px;color:var(--accent);font-size:34px;margin-bottom:10px}.welcome h2{font-size:25px;font-weight:500;letter-spacing:-.6px;margin-bottom:10px}.welcome p{font-size:12px;color:var(--muted);line-height:1.8;margin:0}.suggestions{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;width:100%;margin-top:30px}.suggestions button{text-align:left;background:#191c27;padding:16px 13px}.suggestions strong{display:block;font-size:11px;font-weight:550}.suggestions span{display:block;font-size:10px;color:var(--muted);line-height:1.6;margin-top:8px}.message{margin:0 auto 24px;max-width:790px}.message-label{color:var(--accent);font-size:9px;letter-spacing:1.3px;margin-bottom:10px}.message.user .message-label{color:var(--muted)}.message-content{white-space:pre-wrap;overflow-wrap:anywhere;line-height:1.75;font-size:13px}.message.user .message-content{background:#202432;border:1px solid #2f3444;border-radius:11px;padding:13px 16px}.attachment-note{display:block;color:var(--muted);margin-top:10px;font-size:11px}.composer-wrap{padding:0 28px 13px}.composer{background:#1b1e2a;border:1px solid #3a3d50;border-radius:13px;box-shadow:0 8px 30px #0002;padding:7px}.composer textarea{display:block;width:100%;background:transparent;resize:vertical;border:0;padding:11px 12px;max-height:180px;min-height:70px;font-size:13px}.composer-tools{display:flex;align-items:center;gap:8px;padding:3px 5px 5px}.composer-tools label{font-size:10px;color:var(--muted);white-space:nowrap}.composer-tools select{border:0;background:transparent;padding:5px;font-size:10px}.send{margin-left:auto;font-size:11px;white-space:nowrap}.send span{padding-left:10px;font-size:16px}.composer-footnote{font-size:9px;color:var(--muted);margin:10px 2px 0;display:flex;justify-content:space-between;gap:15px}.composer-footnote span{white-space:nowrap}#working{font-size:10px;color:var(--mint)}#retry,#save-again,#save-copy{font-size:10px;padding:8px}.notice{margin:12px 28px 0;padding:11px 13px;border:1px solid #38564e;background:#1a2a28;border-radius:8px;color:#b3d8cb;font-size:11px;line-height:1.5;overflow-wrap:anywhere}.notice.error{border-color:#6b424c;background:#302029;color:#f0b3c1}.rename-form{padding:10px 28px;display:flex;gap:8px;align-items:center;font-size:11px}.rename-form input{flex:1}.rename-form button{font-size:11px}.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}[hidden]{display:none!important}@media(max-width:850px){.app{grid-template-columns:195px minmax(0,1fr)}header{padding:21px 19px 16px}.chat-actions{flex-wrap:wrap;max-width:105px}.model-bar,.messages{padding-inline:19px}.composer-wrap{padding-inline:19px}.suggestions{grid-template-columns:1fr}.suggestions button{padding:12px}.suggestions span{display:none}.welcome{margin-top:10px}.model-bar>span{display:none}.composer-footnote span{display:none}.composer-tools{flex-wrap:wrap}.notice{margin-inline:19px}}@media(max-width:600px){.app{grid-template-columns:1fr}.sidebar{display:none}.chat-actions{max-width:none}header{padding:18px}h1{font-size:20px}.model-bar{padding:10px 18px}.composer-tools label{max-width:140px}.send{padding:9px}.welcome h2{font-size:22px}}\n\n@media(max-width:600px){.app{height:100dvh;grid-template-rows:auto minmax(0,1fr)}.sidebar{display:flex;flex-direction:row;align-items:center;justify-content:space-between;gap:12px;padding:10px 18px;border-bottom:1px solid var(--line);border-right:0}.sidebar .brand{margin:0;font-size:14px}.sidebar .brand small{display:none}.sidebar>.primary{margin:0;padding:8px 10px;font-size:11px}.sidebar .search-label,.sidebar #search,.sidebar .history,.sidebar .sidebar-note{display:none}.composer-tools{flex-wrap:wrap}}\n"},"publicKey":"MCowBQYDK2VwAyEAujPt2xYcqLkorZIdmrBEa0ZlLml+yEERDhP+YtI2t5o=","signature":"QecC7UTvleIMc27E1TJy/gFCHhVYtFqqKjijnnvRmHt0EpviTTDQsTltMjRWrccLK1YaHAXJnwAe+37J9cm8Dw=="}